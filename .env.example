# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=predmaint
POSTGRES_PASSWORD=changeme_generate_a_real_password
POSTGRES_DB=predictive_maintenance
DATABASE_URL=postgresql+psycopg://predmaint:changeme_generate_a_real_password@db:5432/predictive_maintenance

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=REPLACE_ME
MQTT_PASSWORD=REPLACE_ME
MQTT_TLS_ENABLED=false

# --- Simulator ---
SIMULATOR_DEFAULT_INTERVAL_SECONDS=5

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Logging ---
LOG_LEVEL=INFO
